# ═══════════════════════════════════════════════════════════════
#  POLYBOT CONFIGURATION
#  Copy this to .env and fill in your credentials
# ═══════════════════════════════════════════════════════════════

# ── TRADING MODE ────────────────────────────────────────────────
# Controls which executor runs. One env var = full mode switch.
#
#   paper      → no real orders, simulated fills (use this now)
#   global     → real orders, direct wallet signing (non-US Polymarket)
#   us         → real orders, FCM-intermediated (US Polymarket, CFTC regulated)
#
POLYMARKET_MODE=paper


# ── PAPER MODE ──────────────────────────────────────────────────
# No credentials needed. Just set POLYMARKET_MODE=paper and run.


# ── GLOBAL MODE (direct MetaMask wallet) ────────────────────────
# Get these from: polymarket.com → Settings → API Keys
#
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
POLY_PRIVATE_KEY=       # MetaMask → Account → Export Private Key


# ── US MODE (CFTC-regulated, FCM-intermediated) ─────────────────
# Get these from: polymarket.com → Settings → API Keys (US portal)
# Available once approved off the waitlist.
#
# Key difference: no private key needed. FCM handles signing.
# You only provide your wallet ADDRESS (public key).
#
POLY_US_API_KEY=
POLY_US_API_SECRET=
POLY_US_API_PASSPHRASE=
POLY_US_WALLET_ADDRESS=     # Your 0x... MetaMask address (NOT private key)
# POLY_US_CLOB_HOST=https://clob.polymarket.com   # override if US uses different endpoint


# ── COPY STRATEGY ─────────────────────────────────────────────
# COPY_STRATEGY=proportional       # "proportional" or "fixed"
# MIN_COPY_USDC=0.50               # Ignore trades below this size
# MAX_TRADE_PCT=0.05               # Max 5% of balance per trade
# MAX_WALLET_PCT=0.30              # Max 30% exposure per tracked wallet
# MAX_MARKET_PCT=0.10              # Max 10% exposure per market
# PAPER_STARTING_BALANCE=1000.0    # Virtual balance for paper mode
# POLL_INTERVAL=30                 # How often to check for new trades (seconds)
# RESOLUTION_CHECK_INTERVAL=60    # How often to check for resolved markets

# ── WEBSOCKET PRICE FEED (optional) ──────────────────────────
# USE_WEBSOCKET_PRICES=false       # Enable real-time price feed via WebSocket


# ── BTC 5-MIN DIVERGENCE STRATEGY ─────────────────────────────
# Autonomous strategy: trades BTC Up/Down 5-min markets on Polymarket
# when BTC momentum diverges from implied probability.
# DIVERGENCE_ENABLED=true              # Enable/disable the divergence strategy
# DIVERGENCE_MIN_EDGE=0.05             # Minimum edge to trade (5% = 0.05)
# DIVERGENCE_OBS_SECONDS=30            # Observe BTC this many seconds before close
# DIVERGENCE_BASE_SIZE=10.0            # Base Kelly trade size ($)
# DIVERGENCE_MAX_SIZE=30.0             # Max Kelly trade size ($)
# DIVERGENCE_STREAK_LIMIT=3            # Cooldown after N consecutive losses


# ── CREDENTIAL ENCRYPTION ─────────────────────────────────────
# Master key for encrypting API credentials in the database.
# Generate: python -c "from credentials import generate_master_key; print(generate_master_key())"
DENSEWEALTH_MASTER_KEY=

# ── OPERATOR DASHBOARD AUTH ──────────────────────────────────
# Generate password hash: python generate_password.py
# Operator = full control (approve/reject trades, toggle modes)
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD_HASH=
# Viewer = read-only (can see everything, can't change anything)
# VIEWER_USERNAME=
# VIEWER_PASSWORD_HASH=
SESSION_SECRET=                     # Random string: python -c "import secrets; print(secrets.token_hex(32))"
# SESSION_MAX_AGE_HOURS=24

# ── TRADE APPROVAL ──────────────────────────────────────────
# PENDING_TRADE_TIMEOUT_MINUTES=10  # Pending trades expire after this many minutes


# ═══════════════════════════════════════════════════════════════════════════
#  KALSHI INTEGRATION (Prediction Markets)
# ═══════════════════════════════════════════════════════════════════════════

# ── KALSHI API CREDENTIALS ──────────────────────────────────────────────────
# Get these from: kalshi.com → Settings → API Keys
#
# Create an API key and download the private key PEM file.
# Kalshi uses RSA-PSS signatures (different from Polymarket's simple API keys).
#
KALSHI_API_KEY_ID=                     # The key ID (e.g., "687eba92-2ba6-474b-884d-...")
KALSHI_PRIVATE_KEY_PATH=               # Path to RSA private key file (e.g., "./kalshi_private.pem")
# OR use inline PEM (replace newlines with \n):
# KALSHI_PRIVATE_KEY_PEM=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----

# ── KALSHI MODE ─────────────────────────────────────────────────────────────
KALSHI_DEMO_MODE=false                  # true = use demo-api.kalshi.co, false = production
