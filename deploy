#!/bin/bash
# ══════════════════════════════════════════════════════════════════
#  DENSEWEALTH DEPLOY SCRIPT
#  Usage: ./deploy [command]
#
#  Commands:
#    (no args)  - Full deploy (code + restart)
#    code       - Upload code only (no restart)
#    env        - Upload .env only
#    restart    - Restart services only
#    status     - Check server status
#    logs       - Tail live logs
#    ssh        - Open SSH session
# ══════════════════════════════════════════════════════════════════

SERVER="89.167.68.109"
USER="root"
KEY="$HOME/.ssh/id_ed25519"
LOCAL_DIR="$(cd "$(dirname "$0")" && pwd)"
REMOTE_DIR="/opt/densewealth"

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

header() {
    echo ""
    echo -e "${CYAN}══════════════════════════════════════════════════════════════════${NC}"
    echo -e "${CYAN}  DENSEWEALTH DEPLOY${NC}"
    echo -e "${CYAN}══════════════════════════════════════════════════════════════════${NC}"
    echo ""
}

# Check SSH key
if [ ! -f "$KEY" ]; then
    echo -e "${RED}ERROR: SSH key not found at $KEY${NC}"
    echo "Run: ssh-keygen -t ed25519"
    exit 1
fi

SSH_CMD="ssh -i $KEY -o ConnectTimeout=10 $USER@$SERVER"
SCP_CMD="scp -i $KEY"

upload_code() {
    echo -e "${YELLOW}Uploading Python files...${NC}"
    $SCP_CMD "$LOCAL_DIR"/*.py $USER@$SERVER:$REMOTE_DIR/
}

upload_templates() {
    echo -e "${YELLOW}Uploading templates...${NC}"
    $SCP_CMD "$LOCAL_DIR"/templates/* $USER@$SERVER:$REMOTE_DIR/templates/
}

upload_env() {
    echo -e "${YELLOW}Uploading .env...${NC}"
    $SCP_CMD "$LOCAL_DIR/.env" $USER@$SERVER:$REMOTE_DIR/.env
    $SSH_CMD "chown densewealth:densewealth $REMOTE_DIR/.env && chmod 600 $REMOTE_DIR/.env"
}

set_permissions() {
    echo -e "${YELLOW}Setting permissions...${NC}"
    $SSH_CMD "chown -R densewealth:densewealth $REMOTE_DIR/*.py $REMOTE_DIR/templates/* 2>/dev/null"
}

restart_services() {
    echo -e "${YELLOW}Restarting services...${NC}"
    $SSH_CMD "systemctl restart densewealth && \
              pkill -f 'python web.py' 2>/dev/null; \
              sleep 1; \
              cd $REMOTE_DIR && nohup $REMOTE_DIR/venv/bin/python web.py --host 0.0.0.0 > /var/log/densewealth-web.log 2>&1 &"
}

show_status() {
    echo ""
    echo -e "${CYAN}─── Service Status ───${NC}"
    $SSH_CMD "systemctl is-active densewealth >/dev/null && echo '✅ Bot: RUNNING' || echo '❌ Bot: STOPPED'"
    $SSH_CMD "ss -tlnp | grep -q 8050 && echo '✅ Dashboard: http://$SERVER:8050' || echo '❌ Dashboard: STOPPED'"
    echo ""
    echo -e "${CYAN}─── Paper Balance ───${NC}"
    $SSH_CMD "densewealth stats 2>/dev/null | head -5" || echo "Could not fetch balance"
    echo ""
    echo -e "${CYAN}─── Recent Logs ───${NC}"
    $SSH_CMD "journalctl -u densewealth --since '2 min ago' --no-pager 2>/dev/null | tail -5"
}

show_help() {
    echo ""
    echo -e "${CYAN}Usage:${NC} ./deploy [command]"
    echo ""
    echo -e "${CYAN}Commands:${NC}"
    echo "  (no args)  Full deploy (upload code + restart)"
    echo "  code       Upload Python files only"
    echo "  env        Upload .env config only"
    echo "  restart    Restart bot and dashboard"
    echo "  status     Check if services are running"
    echo "  logs       Tail live bot logs"
    echo "  ssh        Open SSH session to server"
    echo "  help       Show this help"
    echo ""
    echo -e "${CYAN}Examples:${NC}"
    echo "  ./deploy           # Full deploy"
    echo "  ./deploy code      # Just upload code"
    echo "  ./deploy restart   # Just restart"
    echo "  ./deploy logs      # Watch logs"
    echo ""
}

# Main
header

CMD=${1:-full}

case $CMD in
    full)
        echo -e "${YELLOW}[1/4]${NC} Uploading Python files..."
        upload_code || exit 1
        echo -e "${YELLOW}[2/4]${NC} Uploading templates..."
        upload_templates || exit 1
        echo -e "${YELLOW}[3/4]${NC} Setting permissions..."
        set_permissions
        echo -e "${YELLOW}[4/4]${NC} Restarting services..."
        restart_services
        echo ""
        echo -e "${GREEN}✅ Deploy complete!${NC}"
        sleep 3
        show_status
        ;;
    code)
        upload_code
        set_permissions
        echo -e "${GREEN}Done! Run './deploy restart' to apply.${NC}"
        ;;
    env)
        upload_env
        echo -e "${GREEN}Done! Run './deploy restart' to apply.${NC}"
        ;;
    restart)
        restart_services
        sleep 3
        echo -e "${GREEN}Services restarted!${NC}"
        show_status
        ;;
    status)
        show_status
        ;;
    logs)
        echo -e "${YELLOW}Tailing logs (Ctrl+C to exit)...${NC}"
        $SSH_CMD "journalctl -u densewealth -f"
        ;;
    ssh)
        echo -e "${YELLOW}Opening SSH session...${NC}"
        $SSH_CMD
        ;;
    help)
        show_help
        ;;
    *)
        echo -e "${RED}Unknown command: $CMD${NC}"
        show_help
        exit 1
        ;;
esac

echo ""
